# ============================================================
# Mister DM — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ============================================================

# --- Telegram Bot (aiogram — your control panel) ---
BOT_TOKEN=your_bot_token_here

# --- Telethon (your real Telegram account — outreach sender) ---
TELETHON_API_ID=your_api_id_here
TELETHON_API_HASH=your_api_hash_here

# --- Database ---
# SQLite file path (relative to project root)
DATABASE_URL=sqlite+aiosqlite:///storage/mister_dm.db
